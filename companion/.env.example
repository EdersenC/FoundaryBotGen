# From the repository root, copy this file to companion/.env and replace
# CHANGE_ME. Future starts require only: npm run companion

NPCBOT_PAIRING_TOKEN=CHANGE_ME
NPCBOT_ALLOWED_ORIGINS=http://127.0.0.1:30000,http://localhost:30000
NPCBOT_HOST=127.0.0.1
NPCBOT_PORT=43129
NPCBOT_OLLAMA_URL=http://127.0.0.1:11434
NPCBOT_OLLAMA_MODEL=qwen3:4b-instruct
NPCBOT_REQUEST_TIMEOUT_MS=120000
